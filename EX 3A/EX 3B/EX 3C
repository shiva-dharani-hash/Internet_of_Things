#include "DHT.h" 

#define DHTTYPE DHT11 

#define dht_dpin 4 

DHT dht(dht_dpin, DHTTYPE); 

void setup() { 

  dht.begin(); 

  Serial.begin(9600); 

  Serial.println("Humidity and temperature"); 

  delay(700);} 

void loop() { 

  float h = dht.readHumidity(); 

  float t = dht.readTemperature(); 

  Serial.print("Current humidity = "); 

  Serial.print(h); 

  Serial.print("% "); 

  Serial.print("Temperature = "); 

  Serial.print(t); 

  Serial.println(" C"); 

  delay(800);} 
